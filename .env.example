# Contact form delivery (Resend — https://resend.com)
# Without these the form shows a message asking visitors to email directly.

# API key from the Resend dashboard.
RESEND_API_KEY=

# Must be an address on a domain you've verified in Resend,
# e.g. website@dilshanjanith.me
CONTACT_FROM_EMAIL=

# Where enquiries land. Defaults to site.email if unset.
CONTACT_TO_EMAIL=
